@model DoAn.ViewModels.Auth.RegisterViewModel

@{
    ViewData["Title"] = "Đăng ký";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Đăng ký - Social</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/auth.css"
          asp-append-version="true" />

</head>

<body class="auth-body">

    <main class="auth-page">

        <section class="auth-card register-card">

            <div class="auth-brand">

                <div class="auth-logo">
                    <i class="bi bi-chat-heart-fill"></i>
                </div>

                <div>
                    <h1>Social</h1>
                    <p>Kết nối và chia sẻ cùng mọi người</p>
                </div>

            </div>

            <div class="auth-heading">

                <span class="auth-eyebrow">
                    TẠO TÀI KHOẢN
                </span>

                <h2>Đăng ký</h2>

                <p>
                    Điền thông tin bên dưới để bắt đầu sử dụng Social.
                </p>

            </div>

            <form asp-controller="Auth"
                  asp-action="Register"
                  method="post"
                  class="auth-form"
                  novalidate>

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="auth-validation-summary">
                </div>

                <div class="auth-grid">

                    <div class="auth-field">

                        <label asp-for="Username"
                               class="auth-label">

                            <i class="bi bi-person"></i>
                            Tên đăng nhập

                        </label>

                        <input asp-for="Username"
                               class="auth-control"
                               placeholder="Ví dụ: truc123"
                               autocomplete="username" />

                        <span asp-validation-for="Username"
                              class="auth-error">
                        </span>

                    </div>

                    <div class="auth-field">

                        <label asp-for="FullName"
                               class="auth-label">

                            <i class="bi bi-person-badge"></i>
                            Họ và tên

                        </label>

                        <input asp-for="FullName"
                               class="auth-control"
                               placeholder="Nhập họ và tên"
                               autocomplete="name" />

                        <span asp-validation-for="FullName"
                              class="auth-error">
                        </span>

                    </div>

                    <div class="auth-field auth-field-full">

                        <label asp-for="Email"
                               class="auth-label">

                            <i class="bi bi-envelope"></i>
                            Email

                        </label>

                        <input asp-for="Email"
                               class="auth-control"
                               placeholder="example@gmail.com"
                               autocomplete="email" />

                        <span asp-validation-for="Email"
                              class="auth-error">
                        </span>

                    </div>

                    <div class="auth-field">

                        <label asp-for="Password"
                               class="auth-label">

                            <i class="bi bi-lock"></i>
                            Mật khẩu

                        </label>

                        <div class="auth-password">

                            <input asp-for="Password"
                                   class="auth-control"
                                   id="passwordInput"
                                   placeholder="Nhập mật khẩu"
                                   autocomplete="new-password" />

                            <button type="button"
                                    class="auth-password-toggle"
                                    data-target="passwordInput"
                                    aria-label="Hiện hoặc ẩn mật khẩu">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="Password"
                              class="auth-error">
                        </span>

                    </div>

                    <div class="auth-field">

                        <label asp-for="ConfirmPassword"
                               class="auth-label">

                            <i class="bi bi-shield-check"></i>
                            Xác nhận mật khẩu

                        </label>

                        <div class="auth-password">

                            <input asp-for="ConfirmPassword"
                                   class="auth-control"
                                   id="confirmPasswordInput"
                                   placeholder="Nhập lại mật khẩu"
                                   autocomplete="new-password" />

                            <button type="button"
                                    class="auth-password-toggle"
                                    data-target="confirmPasswordInput"
                                    aria-label="Hiện hoặc ẩn mật khẩu">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="ConfirmPassword"
                              class="auth-error">
                        </span>

                    </div>

                </div>

                <div class="password-rules">

                    <div class="password-rules-title">

                        <i class="bi bi-info-circle"></i>

                        Mật khẩu cần có:

                    </div>

                    <div class="password-rules-grid">

                        <span id="ruleLength">
                            <i class="bi bi-circle"></i>
                            Ít nhất 8 ký tự
                        </span>

                        <span id="ruleUpper">
                            <i class="bi bi-circle"></i>
                            Một chữ in hoa
                        </span>

                        <span id="ruleLower">
                            <i class="bi bi-circle"></i>
                            Một chữ thường
                        </span>

                        <span id="ruleNumber">
                            <i class="bi bi-circle"></i>
                            Một chữ số
                        </span>

                        <span id="ruleSpecial">
                            <i class="bi bi-circle"></i>
                            Một ký tự đặc biệt
                        </span>

                        <span id="ruleConfirm">
                            <i class="bi bi-circle"></i>
                            Mật khẩu xác nhận khớp
                        </span>

                    </div>

                </div>

                <button type="submit"
                        class="auth-submit">

                    <i class="bi bi-person-plus-fill"></i>

                    Đăng ký tài khoản

                </button>

            </form>

            <div class="auth-footer">

                <span>
                    Đã có tài khoản?
                </span>

                <a asp-controller="Auth"
                   asp-action="Login">

                    Đăng nhập ngay

                </a>

            </div>

        </section>

    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>

    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        (() => {
            const password =
                document.getElementById("passwordInput");

            const confirmPassword =
                document.getElementById("confirmPasswordInput");

            const toggles =
                document.querySelectorAll(".auth-password-toggle");

            const rules = {
                length: document.getElementById("ruleLength"),
                upper: document.getElementById("ruleUpper"),
                lower: document.getElementById("ruleLower"),
                number: document.getElementById("ruleNumber"),
                special: document.getElementById("ruleSpecial"),
                confirm: document.getElementById("ruleConfirm")
            };

            function updateRule(element, valid) {
                if (!element) {
                    return;
                }

                element.classList.toggle("valid", valid);

                const icon = element.querySelector("i");

                if (icon) {
                    icon.className = valid
                        ? "bi bi-check-circle-fill"
                        : "bi bi-circle";
                }
            }

            function updatePasswordRules() {
                const value = password?.value ?? "";
                const confirmValue = confirmPassword?.value ?? "";

                updateRule(
                    rules.length,
                    value.length >= 8
                );

                updateRule(
                    rules.upper,
                    /[A-Z]/.test(value)
                );

                updateRule(
                    rules.lower,
                    /[a-z]/.test(value)
                );

                updateRule(
                    rules.number,
                    /\d/.test(value)
                );

                updateRule(
                    rules.special,
                    /[^a-zA-Z0-9]/.test(value)
                );

                updateRule(
                    rules.confirm,
                    value.length > 0 &&
                    confirmValue.length > 0 &&
                    value === confirmValue
                );
            }

            toggles.forEach(button => {
                button.addEventListener("click", function () {
                    const input =
                        document.getElementById(
                            this.dataset.target
                        );

                    if (!input) {
                        return;
                    }

                    const show =
                        input.type === "password";

                    input.type = show
                        ? "text"
                        : "password";

                    const icon =
                        this.querySelector("i");

                    if (icon) {
                        icon.className = show
                            ? "bi bi-eye-slash"
                            : "bi bi-eye";
                    }
                });
            });

            password?.addEventListener(
                "input",
                updatePasswordRules
            );

            confirmPassword?.addEventListener(
                "input",
                updatePasswordRules
            );

            updatePasswordRules();
        })();
    </script>

</body>

</html>