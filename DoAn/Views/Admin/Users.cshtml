@model IEnumerable<DoAn.Models.User>
@using DoAn.Models.Enums

@{
    ViewData["Title"] = "Quản lý người dùng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var users = Model?.ToList()
        ?? new List<DoAn.Models.User>();
}

<section class="admin-card">

    <div class="admin-card-header">

        <div>
            <span class="admin-eyebrow">
                QUẢN LÝ TÀI KHOẢN
            </span>

            <h2>Danh sách người dùng</h2>

            <p>
                Tổng cộng @users.Count tài khoản.
            </p>
        </div>

    </div>

    @if (users.Count == 0)
    {
        <div class="admin-empty">
            <i class="fa-solid fa-users-slash"></i>
            <h3>Chưa có người dùng</h3>
        </div>
    }
    else
    {
        <div class="admin-table-wrapper">

            <table class="admin-table">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Người dùng</th>
                        <th>Email</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var user in users)
                    {
                        <tr>

                            <td>#@user.Id</td>

                            <td>
                                <div class="admin-user-cell">

                                    <span class="admin-user-avatar">

                                        @if (!string.IsNullOrWhiteSpace(
                                                                        user.AvatarUrl))
                                        {
                                            <img src="@user.AvatarUrl"
                                                 alt="Avatar" />
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-user"></i>
                                        }

                                </span>

                                <div>
                                    <strong>
                                        @(string.IsNullOrWhiteSpace(
                                                                            user.FullName)
                                                                            ? "Người dùng"
                                                                            : user.FullName)
                                </strong>

                                        <small>
                                            @@@user.Username
                                        </small>
                                    </div>

                                </div>
                            </td>

                            <td>@user.Email</td>

                            <td>
                        @if (user.Role == UserRole.Admin)
                                {
                                    <span class="admin-status admin-status-primary">
                                        Quản trị viên
                                    </span>
                                }
                                else
                                {
                                    <span class="admin-status admin-status-neutral">
                                        Người dùng
                                    </span>
                                }
                            </td>

                            <td>
                                @switch (user.Status)
                                {
                                    case UserStatus.Active:
                                        <span class="admin-status admin-status-success">
                                            Hoạt động
                                        </span>
                                        break;

                                    case UserStatus.Suspended:
                                        <span class="admin-status admin-status-warning">
                                            Tạm khóa
                                        </span>
                                        break;

                                    case UserStatus.Banned:
                                        <span class="admin-status admin-status-danger">
                                            Bị cấm
                                        </span>
                                        break;
                                }
                        </td>

                        <td>
                            @(user.CreatedAt
                                                    .ToLocalTime()
                                                    .ToString("dd/MM/yyyy"))
                    </td>

                            <td>
                                <div class="admin-table-actions">

                                    <a asp-action="UserDetails"
                                       asp-route-id="@user.Id"
                                       class="admin-icon-btn admin-icon-view"
                                       title="Xem chi tiết">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>

                                    <a asp-action="EditUser"
                                       asp-route-id="@user.Id"
                                       class="admin-icon-btn admin-icon-edit"
                                       title="Chỉnh sửa">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>

                            @if (user.Status == UserStatus.Active)
                                    {
                                        <form asp-action="SuspendUser"
                                              method="post"
                                              class="admin-inline-form"
                                              onsubmit="return confirm('Khóa tài khoản này?');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@user.Id" />

                                            <button type="submit"
                                                    class="admin-icon-btn admin-icon-warning"
                                                    title="Tạm khóa">
                                                <i class="fa-solid fa-lock"></i>
                                            </button>

                                        </form>

                                        <form asp-action="BanUser"
                                              method="post"
                                              class="admin-inline-form"
                                              onsubmit="return confirm('Cấm tài khoản này?');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@user.Id" />

                                            <button type="submit"
                                                    class="admin-icon-btn admin-icon-danger"
                                                    title="Cấm tài khoản">
                                                <i class="fa-solid fa-ban"></i>
                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="ActivateUser"
                                              method="post"
                                              class="admin-inline-form"
                                              onsubmit="return confirm('Mở khóa tài khoản này?');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@user.Id" />

                                            <button type="submit"
                                                    class="admin-icon-btn admin-icon-success"
                                                    title="Mở khóa">
                                                <i class="fa-solid fa-lock-open"></i>
                                            </button>

                                        </form>
                                    }

                                    <form asp-action="DeleteUser"
                                          method="post"
                                          class="admin-inline-form"
                                          onsubmit="return confirm('Xóa tài khoản và toàn bộ dữ liệu liên quan?');">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@user.Id" />

                                        <button type="submit"
                                                class="admin-icon-btn admin-icon-danger"
                                                title="Xóa">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>

                                    </form>

                                </div>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</section>